# Copy this file to .env and fill in your own values. Never commit .env.

# --- Tradier (broker) ---
# Get sandbox keys at https://developer.tradier.com (free, no funding required)
TRADIER_API_KEY=
TRADIER_ACCOUNT_ID=
# paper = sandbox endpoint / fake fills. live = real money, real orders. Defaults to paper if unset.
TRADIER_MODE=paper

# --- News agent (optional but recommended) ---
# Free tier at https://finnhub.io — used for economic calendar + headlines
FINNHUB_API_KEY=

# Used for LLM headline sentiment read. If unset, the news agent falls back to
# the quantitative (VIX + calendar) gate only.
ANTHROPIC_API_KEY=
